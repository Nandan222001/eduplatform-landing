# Production URL (canonical links, sitemap, share previews)
SITE_URL=https://sarasvi.nmtsolution.com

# ---- Supabase (server-only: set in Vercel -> Settings -> Environment Variables) ----
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# The *service_role* key (secret). Never prefix with PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; used to scramble visitor IPs before storing them.
IP_HASH_SALT=

# ---- Email alert for every new enquiry (Resend, free plan) ----
# resend.com -> API Keys. Sign up with the NOTIFY_EMAIL address: until you verify
# a sending domain, Resend only delivers to the account owner's own address.
RESEND_API_KEY=
NOTIFY_EMAIL=nmtsolutiontech@gmail.com
# Optional once your domain is verified in Resend, e.g. Sarasvi <hello@nmtsolution.com>
NOTIFY_FROM=

# ---- Admin panel at /admin ----
# Password for the admin login. Pick a long one (16+ characters); the panel stays
# locked while this is empty. Login email defaults to the first NOTIFY_EMAIL.
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Contact mailbox shown on the site and used if the backend is unreachable
PUBLIC_CONTACT_EMAIL=hello@sarasvi.in
# Optional: Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to skip GA.
PUBLIC_GA_ID=
