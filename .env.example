# Production URL (canonical links, sitemap, share previews)
SITE_URL=https://www.sarasvi.in

# ---- Supabase (server-only: set in Vercel -> Settings -> Environment Variables) ----
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# The *service_role* key (secret). Never prefix with PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; used to scramble visitor IPs before storing them.
IP_HASH_SALT=

# Contact mailbox shown on the site and used if the backend is unreachable
PUBLIC_CONTACT_EMAIL=hello@sarasvi.in
# Optional: Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to skip GA.
PUBLIC_GA_ID=
