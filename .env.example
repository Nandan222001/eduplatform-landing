# Production URL (canonical, sitemap, Open Graph)
SITE_URL=https://www.sarasvi.in
# Form backend (Formspree / Getform / Basin / your own API). Accepts JSON POST.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your_form_id
# Fallback mailbox if no endpoint is configured
PUBLIC_CONTACT_EMAIL=hello@sarasvi.in
# Google Analytics 4 Measurement ID. Leave empty to ship without analytics.
PUBLIC_GA_ID=G-XXXXXXXXXX
