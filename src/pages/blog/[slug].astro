---
import Layout from '../../layouts/Layout.astro';
import { getPosts, fmtDate } from '../../lib/blog';

export function getStaticPaths() {
  const posts = getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, related: posts.filter((p) => p.slug !== post.slug).slice(0, 3) },
  }));
}

const { post, related } = Astro.props;
const { meta, Content, slug } = post;
const site = Astro.site?.origin ?? 'https://www.sarasvi.site';
const url = `${site}/blog/${slug}/`;
const schema: object[] = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: meta.title,
  description: meta.description,
  datePublished: meta.date,
  dateModified: meta.date,
  mainEntityOfPage: url,
  image: meta.cover ? site + meta.cover : site + '/og-image.jpg',
  keywords: (meta.keywords ?? []).join(', '),
  author: { '@type': 'Organization', name: 'Sarasvi', url: site + '/' },
  publisher: { '@type': 'Organization', name: 'Sarasvi', logo: { '@type': 'ImageObject', url: site + '/logo-512.png' } },
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Sarasvi', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: site + '/blog/' },
    { '@type': 'ListItem', position: 3, name: meta.title, item: url },
  ],
}];
if (meta.faqs?.length) schema.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: meta.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
});
---
<Layout title={`${meta.title} | Sarasvi`} description={meta.description} path={`/blog/${slug}/`} schema={schema}>
  <main class="post container" id="main">
    <p class="crumb"><a href="/">Sarasvi</a> / <a href="/blog/">Blog</a></p>
    <article>
      <header>
        <h1>{meta.title}</h1>
        <p class="meta"><time datetime={meta.date}>{fmtDate(meta.date)}</time> · {Math.max(1, Math.round(post.words / 200))} min read · Sarasvi team</p>
        {meta.cover && <img class="cover" src={meta.cover} alt={meta.coverAlt ?? ''} width="1200" height="675" fetchpriority="high" />}
      </header>
      <div class="prose"><Content /></div>
      {meta.faqs?.length ? (
        <section class="faq">
          <h2>Frequently asked questions</h2>
          {meta.faqs.map(([q, a]) => <><h3>{q}</h3><p>{a}</p></>)}
        </section>
      ) : null}
    </article>

    <aside class="cta">
      <h2>Try Sarasvi free for 30 days</h2>
      <p>Attendance, fees by UPI, a parent app, exams and AI study help in one platform. No credit card, and we move your Excel data for free.</p>
      <a class="btn btn-primary" href="/#book-demo">Book a free demo</a>
      <p class="contact">Or email <a href="mailto:contact@sarasvi.site">contact@sarasvi.site</a> · WhatsApp <a href="https://wa.me/919226002903">+91 92260 02903</a></p>
    </aside>

    {related.length > 0 && (
      <nav class="related" aria-label="More articles">
        <h2>More from the blog</h2>
        <ul>{related.map((p) => <li><a href={`/blog/${p.slug}/`}>{p.meta.title}</a></li>)}</ul>
      </nav>
    )}
  </main>
</Layout>

<style>
  .post{padding:calc(var(--header-h) + clamp(32px,5vw,56px)) var(--pad-x) clamp(56px,7vw,80px);max-width:780px}
  .crumb{font-size:.9rem;color:var(--ink-2)}
  .crumb a{color:var(--ink-2)}
  h1{font-size:clamp(1.9rem,4vw,2.6rem);line-height:1.2;margin:10px 0 10px}
  .meta{color:var(--ink-2);font-size:.92rem;margin-bottom:22px}
  .cover{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:var(--r-card);box-shadow:var(--shadow-md);margin-bottom:clamp(24px,4vw,36px)}
  .prose{font-size:1.08rem;line-height:1.75;color:var(--ink)}
  .prose :global(h2){font-size:clamp(1.4rem,2.6vw,1.75rem);margin:2em 0 .6em;line-height:1.3}
  .prose :global(h3){font-size:1.2rem;margin:1.6em 0 .5em}
  .prose :global(p),.prose :global(ul),.prose :global(ol){margin:0 0 1.1em}
  .prose :global(ul),.prose :global(ol){padding-left:1.4em}
  .prose :global(li){margin-bottom:.4em}
  .prose :global(a){color:var(--primary);text-decoration:underline}
  .prose :global(table){width:100%;border-collapse:collapse;margin:0 0 1.2em;font-size:.97rem;display:block;overflow-x:auto}
  .prose :global(th),.prose :global(td){border:1px solid var(--divider);padding:8px 10px;text-align:left}
  .prose :global(th){background:var(--secondary-light)}
  .prose :global(blockquote){border-left:4px solid var(--primary);margin:0 0 1.1em;padding:4px 0 4px 16px;color:var(--ink-2)}
  .faq{margin-top:2.4em}
  .faq h3{font-size:1.1rem;margin:1.2em 0 .4em}
  .cta{margin-top:clamp(40px,6vw,64px);padding:var(--pad-card);border-radius:var(--r-card);background:var(--secondary-dark);color:#fff}
  .cta h2{color:#fff;margin:0 0 8px}
  .cta p{color:var(--secondary-light);margin:0 0 18px}
  .cta .contact{margin:16px 0 0;font-size:.92rem}
  .cta .contact a{color:#fff}
  .related{margin-top:clamp(36px,5vw,52px)}
  .related ul{padding-left:1.1em}
  .related a{color:var(--primary)}
</style>
