---
import '../../styles/fonts.css';
import '../../styles/admin.css';
// Admin panel shell. Not part of the public site: noindex, no analytics, no site
// header. All data comes from /api/admin/* after login.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sarasvi Admin</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#3B2314" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
  </head>
  <body>
    <div id="app" aria-live="polite"></div>
    <noscript><p style="padding:24px">JavaScript is required for the admin panel.</p></noscript>
    <script>
      import '../../scripts/admin.js';
    </script>
  </body>
</html>
