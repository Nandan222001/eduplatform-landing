---
import LeadForm from "./LeadForm.astro";
---
<section class="section" id="cta">
  <div class="container">
    <div class="cta-banner reveal">
      <picture><source media="(max-width:700px)" srcset="/images/community-m.webp"><img loading="lazy" decoding="async" width="1440" height="960" class="bg" src="/images/community.webp" alt=""></picture>
      <div class="cta-inner">
        <div>
          <h2>Ready to Transform Your Institution?</h2>
          <p>Join 500+ schools and 2 million learners already growing with Sarasvi. Full-featured 30-day trial, free data migration, and a success team that answers in minutes.</p>
          <div style="display:flex;gap:14px;flex-wrap:wrap">
            <a href="#book-demo" class="btn btn-white">Start Your Free Trial <svg class="icon"><use href="#i-arrow"/></svg></a>
            <a href="#pricing" class="btn btn-ghost">See Pricing</a>
          </div>
        </div>
        <LeadForm />
      </div>
    </div>
  </div>
</section>
