---
// Reviews are never typed in here. They come from /api/reviews: real feedback from
// the form where the customer ticked "may publish" AND the admin approved it in the
// admin panel (Feedback -> "Show on website"), shown word for word.
const endpoint = '/api/submit'; // Supabase via src/pages/api/submit.ts
const email = import.meta.env.PUBLIC_CONTACT_EMAIL ?? 'hello@sarasvi.in';
---
<section class="section alt-bg" id="testimonials">
  <div id="reviewsBlock" hidden>
    <div class="container center">
      <span class="eyebrow gold"><svg class="icon"><use href="#i-msg"/></svg> From our customers</span>
      <h2 class="section-title">What Schools <span class="grad-text">Are Saying</span></h2>
    </div>
    <div class="container">
      <div class="t-carousel" id="tCarousel"></div>
    </div>
  </div>

  <div class="container fb-wrap reveal" id="feedback">
    <div class="fb-copy">
      <span class="eyebrow gold"><svg class="icon"><use href="#i-msg"/></svg> Already using Sarasvi?</span>
      <h2 class="section-title">Tell Us How It's <span class="grad-text">Going</span></h2>
      <p>Principals, teachers and parents: your honest feedback helps us make Sarasvi better for every school. Good or bad, we read every word.</p>
      <p>If you're happy for us to share your words on this website, tick the box. We'll publish them exactly as you wrote them, and only with your permission.</p>
    </div>
    <div class="form-card">
      <h3>Share your feedback</h3>
      <form class="lead-form" method="post" action={endpoint} data-endpoint={endpoint} data-email={email} data-form="feedback" novalidate>
        <div class="f-row">
          <div class="field">
            <label for="fb-name">Your name <span aria-hidden="true">*</span></label>
            <input id="fb-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" />
            <span class="err" data-err-for="name"></span>
          </div>
          <div class="field">
            <label for="fb-email">Email <span aria-hidden="true">*</span></label>
            <input id="fb-email" name="email" type="email" autocomplete="email" required inputmode="email" maxlength="200" />
            <span class="err" data-err-for="email"></span>
          </div>
        </div>
        <div class="f-row">
          <div class="field">
            <label for="fb-role">You are a</label>
            <select id="fb-role" name="role">
              <option>Principal / Head</option><option>Teacher</option><option>Parent</option><option>Office / Admin staff</option><option>Student</option><option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="fb-org">School and city <span aria-hidden="true">*</span></label>
            <input id="fb-org" name="institution" type="text" autocomplete="organization" required maxlength="150" />
            <span class="err" data-err-for="institution"></span>
          </div>
        </div>
        <div class="field">
          <label for="fb-msg">Your feedback <span aria-hidden="true">*</span></label>
          <textarea id="fb-msg" name="message" rows="4" required minlength="10" maxlength="1000" placeholder="What has changed for you since using Sarasvi? What could be better?"></textarea>
          <span class="err" data-err-for="message"></span>
        </div>
        <div class="hp" aria-hidden="true"><label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="consent">
          <input type="checkbox" name="publish" value="yes" />
          <span>Sarasvi may publish my feedback on its website with my name, role and school, word for word.</span>
        </label>
        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>I accept the <a href="/privacy/">Privacy Policy</a>.</span>
        </label>
        <span class="err" data-err-for="consent"></span>
        <button class="btn btn-primary form-submit" type="submit"><span class="lbl">Send feedback</span><span class="spin" aria-hidden="true"></span></button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
<script>
  // Fills the reviews carousel from approved feedback; the block stays hidden when there is none.
  (function () {
    var block = document.getElementById('reviewsBlock'), box = document.getElementById('tCarousel');
    if (!block || !box) return;
    var esc = function (v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    fetch('/api/reviews').then(function (r) { return r.json(); }).then(function (j) {
      var list = (j && j.reviews) || []; if (!list.length) return;
      box.innerHTML = list.map(function (r, i) {
        var ini = esc(String(r.name || '?').split(/\s+/).map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase());
        var who = [r.role, r.institution].filter(Boolean).join(' · ');
        return '<div class="t-slide' + (i === 0 ? ' active' : '') + '"><p class="t-quote">\u201C' + esc(r.message) + '\u201D</p><div class="t-person"><div class="t-avatar" style="background:linear-gradient(135deg,#BF5000,#8A3A00)" aria-hidden="true">' + ini + '</div><div class="who"><b>' + esc(r.name) + '</b><span>' + esc(who) + '</span></div></div></div>';
      }).join('') + (list.length > 1 ? '<div class="t-nav"><button id="tPrev" aria-label="Previous review">\u2039</button><button id="tNext" aria-label="Next review">\u203A</button></div>' : '');
      block.hidden = false;
      if (list.length < 2) return;
      var slides = box.querySelectorAll('.t-slide'), n = 0, timer;
      function show(x) { n = (x + slides.length) % slides.length; slides.forEach(function (s, k) { s.classList.toggle('active', k === n); }); }
      function reset() { clearInterval(timer); timer = setInterval(function () { show(n + 1); }, 6500); }
      document.getElementById('tPrev').onclick = function () { show(n - 1); reset(); };
      document.getElementById('tNext').onclick = function () { show(n + 1); reset(); };
      reset();
    }).catch(function () {});
  })();
</script>
