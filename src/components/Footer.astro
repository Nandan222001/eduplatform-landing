---
const email = import.meta.env.PUBLIC_CONTACT_EMAIL ?? 'hello@sarasvi.example';
const endpoint = '/api/submit'; // Supabase via src/pages/api/submit.ts

const columns = [
  {
    title: 'Product',
    links: [
      ['#tour', 'Product Tour'],
      ['#academics', 'Academics Core'],
      ['#ai', 'Smart AI Help'],
      ['#engage', 'Gamification'],
      ['#parents', 'Parent Portal'],
      ['#mobile', 'Mobile Apps'],
      ['#pricing', 'Pricing'],
    ],
  },
  {
    title: 'Solutions',
    links: [
      ['#roles', 'K-12 Schools'],
      ['#roles', 'Institution Groups'],
      ['#roles', 'Coaching Institutes'],
      ['#academics', 'Examinations Board'],
      ['#engage', 'Student Engagement'],
      ['#pricing', 'School Groups & Own Branding'],
    ],
  },
  {
    title: 'Company',
    links: [
      ['#book-demo', 'Contact Sales'],
      ['#faq', 'FAQ'],
      ['#book-demo', 'Book a Demo'],
      ['/privacy/', 'Privacy Policy'],
      ['/terms/', 'Terms of Service'],
    ],
  },
];

const badges = ['Private & secure', 'Always on', 'Your data stays yours', 'Made in India'];
---

<footer class="site-footer">
  <div class="container">
    <h2 class="sr-only">Sarasvi — site footer</h2>

    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="/" aria-label="Sarasvi home">
          <span class="logo-mark"><img src="/images/brand/sarasvi-mark.png" alt="" width="34" height="34" loading="lazy" /></span>
          <span class="logo-type"><span class="logo-text">Sarasv<span class="logo-i">i</span></span><span class="logo-tag">Wisdom &middot; Learning</span></span>
        </a>
        <p class="tagline">Wisdom Through Education</p>
        <p class="foot-blurb">One simple place to run your whole school — on the web (Sarasvi Portal) and on Android and iPhone (Sarasvi Mobile).</p>
      </div>

      {columns.map((col) => (
        <nav class="foot-col" aria-label={col.title}>
          <h3>{col.title}</h3>
          <ul>
            {col.links.map(([href, label]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="foot-news">
      <div class="foot-news-copy">
        <h3>Product updates</h3>
        <p>Release notes, teaching ideas and campus case studies — once a month, no spam.</p>
        <div class="trust-badges">
          {badges.map((badge) => <span>{badge}</span>)}
        </div>
      </div>

      <form class="news-form lead-form" method="post" action={endpoint} data-endpoint={endpoint} data-email={email} data-form="newsletter" novalidate>
        <label for="nl-email" class="sr-only">Email address</label>
        <div class="news-row">
          <input id="nl-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@school.edu" />
          <button class="btn btn-primary btn-sm form-submit" type="submit"><span class="lbl">Subscribe</span><span class="spin" aria-hidden="true"></span></button>
        </div>
        <div class="hp" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
        <span class="err" data-err-for="email"></span>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <div class="foot-bar">
    <div class="container foot-bottom">
      <span>© {new Date().getFullYear()} Sarasvi Technologies Pvt. Ltd. All rights reserved.</span>
      <span class="foot-made">Made with care for educators</span>
      <nav class="foot-legal" aria-label="Legal and contact">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href={`mailto:${email}`}>{email}</a>
      </nav>
    </div>
  </div>
</footer>
