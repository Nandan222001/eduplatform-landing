---
// The 20-second brand film, scrubbed by the scroll wheel.
//
// This one is *not* played, it is seeked: the scroll position inside the
// `.film-scrub` runway is mapped onto `currentTime`, so the film runs forward as
// you scroll down and rewinds when you scroll back. See src/scripts/main.js for
// the loop and global.css for the pinned (sticky) stage.
//
// Why it stays cheap despite being a film:
//  • Nothing is fetched until the section is within two viewports of the
//    read-line (`preload="none"`, sources held in `data-src`, main.js warms it up
//    with an IntersectionObserver). A visitor who never scrolls this far
//    downloads one 27 KB still.
//  • The four WebP stills under the video are what you actually scrub on touch
//    devices, where pinning is unreliable — the browser cross-fades them and no
//    video byte moves unless the visitor asks for sound.
//  • One file, not two: `sarasvi-blessing.mp4` carries the music as well, so the
//    "watch with sound" lightbox reuses the same bytes and nothing extra ships.
//  • Explicit width/height + aspect-ratio + a fixed runway height, so the page
//    never shifts while the film is pinned.
const poster = [1, 2, 3, 4].map((n) => `/media/sarasvi-blessing-p${n}.webp`);
const film = '/media/sarasvi-blessing.mp4';
---

<section class="section film-section" id="film" aria-labelledby="film-title">
  <div class="container center">
    <span class="eyebrow gold"><svg class="icon"><use href="#i-spark"/></svg> Wisdom Through Education</span>
    <h2 class="section-title" id="film-title">Named After <span class="grad-text">Saraswati</span></h2>
    <p class="section-sub">
      Sarasvi takes its name from Saraswati, the goddess of knowledge, music and the arts. This 20-second
      film was made for the brand — scroll through it frame by frame, and it plays; scroll back up and it
      rewinds.
    </p>
  </div>

  <div class="film-scrub" data-film-scrub>
    <div class="film-pin">
      <figure class="film-frame" data-film-frame>
        {poster.map((src, i) => (
          <img
            class={i === 0 ? 'film-still is-on' : 'film-still'}
            data-film-still={i}
            src={src}
            alt=""
            width="1280"
            height="720"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
        <video
          class="film-video"
          data-film-video
          width="1280"
          height="720"
          muted
          playsinline
          preload="none"
          aria-label="Sarasvi brand film: Saraswati playing the veena above an open book, as Sanskrit syllables and musical notes rise in golden light"
        >
          <source data-src={film} type="video/mp4" />
          <p>Your browser can’t play this video. <a href={film}>Download the 20-second film (MP4)</a>.</p>
        </video>
        <span class="film-hint" data-film-hint aria-hidden="true">
          <svg class="icon"><use href="#i-chevron-d"/></svg> Scroll to play
        </span>
        <span class="film-bar" aria-hidden="true"><i data-film-bar></i></span>
      </figure>

      <div class="film-meta">
        <span class="film-clock"><b data-film-clock>0:00</b> <span aria-hidden="true">/</span> 0:20</span>
        <span class="film-tag">20 seconds · made for Sarasvi with Google Gemini</span>
        <button class="film-sound" type="button" data-film-sound>
          <svg class="icon"><use href="#i-volume"/></svg> <span>Watch with sound</span>
        </button>
      </div>
    </div>
  </div>
</section>

<div class="film-lightbox" data-film-box hidden>
  <div class="film-box-backdrop" data-film-close></div>
  <div class="film-box-inner" role="dialog" aria-modal="true" aria-label="Sarasvi brand film, 20 seconds with sound">
    <button class="film-box-close" type="button" data-film-close aria-label="Close the film">
      <svg class="icon"><use href="#i-close"/></svg>
    </button>
    <video class="film-box-video" data-film-full src={film} poster={poster[0]} controls preload="none" playsinline width="1280" height="720"></video>
    <p class="film-box-note">Sarasvi — Wisdom Through Education · 20 seconds, with sound</p>
  </div>
</div>
